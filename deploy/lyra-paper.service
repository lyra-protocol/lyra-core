# Lyra, paper trading, off chain.
#
# The full agent against the live book with no money at risk and nothing written
# to Arweave. Runs beside the harvester and the collector, isolated the same way.
[Unit]
Description=Lyra paper trading (off chain)
After=network-online.target lyra-harvester.service
Wants=network-online.target

[Service]
Type=simple
User=lyra
Group=lyra
WorkingDirectory=/opt/lyra/lyra-core
EnvironmentFile=/opt/lyra/lyra.env
Environment=NODE_ENV=production
Environment=LYRA_DB=/opt/lyra/data/venue.db
Environment=LYRA_EXEC_DB=/opt/lyra/data/exec.db
Environment=LYRA_CYCLE_MS=60000
ExecStart=/opt/lyra/node/bin/node /opt/lyra/lyra-core/dist/paper-main.js
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lyra/data
RestrictSUIDSGID=true
MemoryMax=768M
CPUQuota=40%

StandardOutput=append:/opt/lyra/data/paper.log
StandardError=append:/opt/lyra/data/paper.log

[Install]
WantedBy=multi-user.target
